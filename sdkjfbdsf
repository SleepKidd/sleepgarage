<div class="modal-back" id="modalBack"><div class="modal" id="modal"></div></div><div class="toast-wrap" id="toasts"></div>
<script>
(()=>{
'use strict';
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const rnd=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const pick=a=>a[Math.floor(Math.random()*a.length)];
const money=n=>Math.round(n).toLocaleString('ru-RU')+' ₽';
const deep=o=>JSON.parse(JSON.stringify(o));
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,8);
const STORAGE='sleepkidd_garage_save_v1';
const DEFAULT={money:650000,rep:0,profile:{name:'Driver',xp:0,level:1},career:{perfectParks:0,vinChecks:0,auctionWins:0},daily:{date:'',tasks:[]},achievements:{unlocked:{}},parking:{done:{},best:{},bestScore:{}},dealer:{rulesVersion:4,day:1,market:[],garage:[],capacity:3,showroom:1,auctions:[],auctionDay:0,deals:0,profit:0,bestDeal:0,losses:0,declines:0,expenses:0,revenue:0,totalBought:0,trends:{},event:null},settings:{}};
let state=(()=>{try{const old=JSON.parse(localStorage.getItem(STORAGE));if(!old)return deep(DEFAULT);return {...deep(DEFAULT),...old,parking:{...deep(DEFAULT.parking),...(old.parking||{})},dealer:{...deep(DEFAULT.dealer),...(old.dealer||{})}}}catch{return deep(DEFAULT)}})();
function save(){ensureMeta();try{localStorage.setItem(STORAGE,JSON.stringify(state))}catch{}updateHUD()}
function toast(text,type=''){const t=document.createElement('div');t.className='toast '+type;t.textContent=text;$('#toasts').appendChild(t);setTimeout(()=>t.remove(),2800)}
function modal(html){$('#modal').innerHTML=html;$('#modalBack').classList.add('open')}
$('#modalBack').addEventListener('click',e=>{if(e.target===$('#modalBack'))$('#modalBack').classList.remove('open')});
function go(id){$$('.view').forEach(v=>v.classList.toggle('active',v.id===id));$$('[data-go]').forEach(b=>b.classList.toggle('active',b.dataset.go===id));window.scrollTo({top:0,behavior:'smooth'});if(id==='parking')startParking(parking.level);if(id==='dealer'){ensureDealer();renderMarket();ensureAuctions();renderAuctions()}if(id==='career')renderCareer()}
$$('[data-go]').forEach(b=>b.addEventListener('click',()=>go(b.dataset.go)));
function updateHUD(){
  ensureMeta();$('#hudLevel').textContent=state.profile.level;$('#hudMoney').textContent=Math.round(state.money).toLocaleString('ru-RU');$('#hudRep').textContent=state.rep;
  $('#dealerDay').textContent=state.dealer.day;$('#garageCount').textContent=state.dealer.garage.length;$('#garageCapacity').textContent=state.dealer.capacity;
  $('#statDeals').textContent=state.dealer.deals;$('#statProfit').textContent=money(state.dealer.profit);$('#statExpenses').textContent=money(state.dealer.expenses);$('#statRevenue').textContent=money(state.dealer.revenue);$('#statBest').textContent=money(state.dealer.bestDeal);$('#statLosses').textContent=state.dealer.losses;$('#statDeclines').textContent=state.dealer.declines;$('#statRep').textContent=state.rep;renderHomeCareer();
}


/* ---------- Unified career ---------- */
const dailyPool=[
  {type:'park',title:'Точная работа',text:'Заверши 2 парковки',target:2,xp:90,money:18000},
  {type:'perfect',title:'Без царапины',text:'Заверши парковку без столкновений',target:1,xp:100,money:22000},
  {type:'deal',title:'Закрой сделку',text:'Продай 1 автомобиль',target:1,xp:110,money:25000},
  {type:'profit',title:'День в плюсе',text:'Заработай 80 000 ₽ прибыли со сделок',target:80000,xp:130,money:30000},
  {type:'vin',title:'Проверь историю',text:'Сделай 1 VIN-проверку',target:1,xp:80,money:16000},
  {type:'auction',title:'Молоток',text:'Выиграй 1 автомобиль на аукционе',target:1,xp:150,money:35000}
];
const achievementDefs=[
  {id:'park5',title:'Парковщик',text:'Заверши 5 разных парковок',reward:25000,xp:120,ok:()=>Object.keys(state.parking.done).length>=5},
  {id:'perfect3',title:'Без единой царапины',text:'Сделай 3 идеальные парковки',reward:30000,xp:140,ok:()=>state.career.perfectParks>=3},
  {id:'deal1',title:'Первая прибыль',text:'Закрой первую сделку',reward:30000,xp:120,ok:()=>state.dealer.deals>=1},
  {id:'profit100',title:'Хороший нюх',text:'Сделай сделку с прибылью 100 000 ₽+',reward:45000,xp:180,ok:()=>state.dealer.bestDeal>=100000},
  {id:'vin5',title:'Проверяй факты',text:'Сделай 5 VIN-проверок',reward:40000,xp:160,ok:()=>state.career.vinChecks>=5},
  {id:'auction1',title:'С молотка',text:'Выиграй первый аукцион',reward:35000,xp:150,ok:()=>state.career.auctionWins>=1},
  {id:'million',title:'Первый миллион',text:'Держи на счету 1 000 000 ₽',reward:70000,xp:220,ok:()=>state.money>=1000000},
  {id:'showroom3',title:'Автомагнат',text:'Развей площадку до 3 уровня',reward:100000,xp:300,ok:()=>state.dealer.showroom>=3}
];
const chapterDefs=[
  {title:'Новичок',text:'Освой парковку и первые решения.',ok:()=>true},
  {title:'Первые деньги',text:'Заверши хотя бы одну парковку.',ok:()=>Object.keys(state.parking.done).length>=1},
  {title:'Перекуп',text:'Закрой первую сделку в Car Dealer.',ok:()=>state.dealer.deals>=1},
  {title:'Свой гараж',text:'Расширь гараж минимум до 4 мест.',ok:()=>state.dealer.capacity>=4},
  {title:'Автосалон',text:'Развей торговую площадку до 3 уровня.',ok:()=>state.dealer.showroom>=3}
];
function ensureMeta(){
  state.profile={...deep(DEFAULT.profile),...(state.profile||{})};state.career={...deep(DEFAULT.career),...(state.career||{})};state.daily={...deep(DEFAULT.daily),...(state.daily||{})};state.achievements={...deep(DEFAULT.achievements),...(state.achievements||{})};
  state.dealer.showroom=clamp(Number(state.dealer.showroom)||1,1,3);state.dealer.auctions=state.dealer.auctions||[];state.dealer.auctionDay=state.dealer.auctionDay||0;
  const lvl=levelInfo(state.profile.xp).level;state.profile.level=lvl;ensureDaily();
}
function levelInfo(xp=0){let level=1,used=0,need=500;while(xp>=used+need){used+=need;level++;need=500+(level-1)*180}return {level,used,need,into:xp-used,pct:clamp((xp-used)/need*100,0,100)}}
function todayKey(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function ensureDaily(){const k=todayKey();if(state.daily.date===k&&state.daily.tasks?.length===3)return;const pool=deep(dailyPool).sort(()=>Math.random()-.5).slice(0,3);state.daily={date:k,tasks:pool.map((t,i)=>({...t,id:k+'_'+i,progress:0,claimed:false}))}}
function awardXP(n,reason=''){const before=state.profile.level;state.profile.xp=Math.max(0,(state.profile.xp||0)+Math.round(n));state.profile.level=levelInfo(state.profile.xp).level;if(state.profile.level>before){state.money+=30000*state.profile.level;toast(`Новый уровень ${state.profile.level}! Бонус ${money(30000*state.profile.level)}`,'good')}else if(reason)toast(`+${Math.round(n)} XP · ${reason}`,'good')}
function trackEvent(type,amount=1){ensureDaily();for(const t of state.daily.tasks)if(t.type===type&&!t.claimed)t.progress=clamp((t.progress||0)+amount,0,t.target);checkAchievements()}
function checkAchievements(){ensureMetaShallow();for(const a of achievementDefs){if(!state.achievements.unlocked[a.id]&&a.ok()){state.achievements.unlocked[a.id]=Date.now();state.money+=a.reward;state.profile.xp+=a.xp;state.profile.level=levelInfo(state.profile.xp).level;toast(`Достижение: ${a.title} · +${money(a.reward)}`,'good')}}}
function ensureMetaShallow(){state.profile=state.profile||deep(DEFAULT.profile);state.career=state.career||deep(DEFAULT.career);state.daily=state.daily||deep(DEFAULT.daily);state.achievements=state.achievements||deep(DEFAULT.achievements);state.achievements.unlocked=state.achievements.unlocked||{}}
function careerChapter(){let idx=0;chapterDefs.forEach((c,i)=>{if(c.ok())idx=i});return {index:idx,...chapterDefs[idx]}}
function renderHomeCareer(){if(!$('#homeLevel'))return;ensureMetaShallow();const li=levelInfo(state.profile.xp||0),ch=careerChapter(),unlocked=Object.keys(state.achievements.unlocked||{}).length,done=(state.daily.tasks||[]).filter(t=>t.claimed).length;$('#homeLevel').textContent=li.level;$('#homeChapter').textContent=ch.title;$('#homeXpBar').style.width=li.pct+'%';$('#homeXpText').textContent=`${li.into} / ${li.need} XP`;$('#homeAchievements').textContent=`${unlocked} / ${achievementDefs.length}`;$('#homeDaily').textContent=`${done} / 3`}
