function carSVG(c,id='x'){const col=c.color||'#55aaff',suv=c.type==='SUV',wagon=c.type==='Wagon',hatch=c.type==='Hatchback',coupe=c.type==='Coupe';let roof=coupe?'M136 83 Q174 49 247 48 L308 58 Q348 70 382 105':suv?'M122 71 Q162 35 258 38 L345 60 Q373 70 394 104':wagon?'M122 77 Q160 44 230 42 L327 49 Q362 57 390 104':hatch?'M132 79 Q169 47 244 47 L319 58 Q350 68 380 106':'M130 80 Q173 44 248 44 L320 56 Q355 67 386 105';return `<svg class="car-svg" viewBox="0 0 500 210" aria-hidden="true"><defs><linearGradient id="p${id}" x1="0" x2="1"><stop stop-color="${shade(col,26)}"/><stop offset=".48" stop-color="${col}"/><stop offset="1" stop-color="${shade(col,-38)}"/></linearGradient><linearGradient id="g${id}" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#c5efff" stop-opacity=".7"/><stop offset="1" stop-color="#0a1620" stop-opacity=".95"/></linearGradient></defs><ellipse cx="252" cy="179" rx="190" ry="16" fill="#000" opacity=".38"/><path d="M50 127 Q69 106 106 102 L${roof.substring(1)} Q414 106 445 127 L458 143 L448 168 H53 L41 150Z" fill="url(#p${id})" stroke="#fff" stroke-opacity=".10" stroke-width="2"/><path d="M137 81 Q173 54 236 51 L244 99 H110 Q120 89 137 81Z" fill="url(#g${id})"/><path d="M253 51 L313 62 Q344 71 372 100 H258Z" fill="url(#g${id})"/><path d="M86 129 H426" stroke="#fff" stroke-opacity=".13"/><rect x="203" y="113" width="24" height="4" rx="2" fill="#dceaf4" opacity=".55"/><rect x="318" y="112" width="24" height="4" rx="2" fill="#dceaf4" opacity=".55"/><path d="M434 133 l18 4 -5 13 -18-2z" fill="#ff4e5d"/><path d="M54 133 l22-4 7 9-27 5z" fill="#d9f8ff"/>${wheelSVG(125,164)}${wheelSVG(375,164)}</svg>`}
function wheelSVG(x,y){return `<g transform="translate(${x} ${y})"><circle r="37" fill="#05070a"/><circle r="27" fill="#202834" stroke="#68788b" stroke-width="2"/><circle r="18" fill="none" stroke="#98a7b8" stroke-width="5" stroke-dasharray="5 8"/><circle r="7" fill="#10151c" stroke="#b2bdc8" stroke-width="2"/></g>`}

function vinCheck(id){const c=state.dealer.market.find(x=>x.id===id);if(!c)return;if(c.vinChecked)return toast('VIN уже проверен');const cost=9000;if(state.money<cost)return toast('Не хватает денег на VIN-проверку','bad');state.money-=cost;state.dealer.expenses+=cost;c.vinChecked=true;c.mileage=c.realMileage;c.accidents=c.realAccidents;state.career.vinChecks++;trackEvent('vin',1);awardXP(35,'VIN-проверка');save();renderMarket();const flags=[];if(c.fraud.odometer)flags.push('обнаружена корректировка пробега');if(c.fraud.hiddenAccident)flags.push('обнаружено скрытое ДТП');if(c.history==='taxi')flags.push('работа в такси');if(c.history==='flood')flags.push('следы затопления');toast(flags.length?'VIN: '+flags.join(', '):'VIN: серьёзных расхождений не найдено',flags.length?'warn':'good')}

function inspectCar(id,full=false){const c=state.dealer.market.find(x=>x.id===id);if(!c)return;const cost=full?22000:6000;if(!full&&c.inspectionLevel>=1)return showReport(c);if(full&&c.inspectionLevel>=2)return showReport(c);if(state.money<cost)return toast('Не хватает денег','bad');state.money-=cost;state.dealer.expenses+=cost;c.inspectionLevel=Math.max(c.inspectionLevel,full?2:1);revealSome(c,full);save();renderMarket();showReport(c)}
function showReport(c){const known=knownIssues(c),risk=riskOf(c),avg=Math.round(componentAvg(c));let estimate='Недоступна';if(c.inspectionLevel===1)estimate=`${money(trueValue(c)*.80)} — ${money(trueValue(c)*1.17)}`;if(c.inspectionLevel>=2)estimate=`${money(trueValue(c)*.92)} — ${money(trueValue(c)*1.07)}`;const comps=Object.entries(c.components).map(([k,v])=>`<div class="fact">${componentNames[k]}<strong>${c.inspectionLevel>=2?v+'%':c.inspectionLevel===1?(v<65?'плохо':v<82?'средне':'хорошо'):'?'}</strong></div>`).join('');const issues=known.length?known.map(i=>`<div class="issue"><b>${i.name}</b><span class="muted">Ориентир ремонта ${money(i.estimate*.85)}–${money(i.estimate*1.35)}</span></div>`).join(''):'<div class="issue"><b style="color:var(--good)">Явных дефектов не найдено</b><span class="muted">Это не означает, что скрытых проблем нет.</span></div>';modal(`<h3>${c.brand} ${c.model}</h3><p class="muted">${c.inspectionLevel>=2?'Полная':'Базовая'} диагностика · риск: ${risk[0]} · VIN: ${c.vinChecked?'проверен':'не проверен'}</p><div class="modal-grid"><div class="stat"><span class="muted">Среднее состояние</span><strong>${avg}%</strong></div><div class="stat"><span class="muted">Оценка рынка</span><strong style="font-size:15px">${estimate}</strong></div></div><div class="facts">${comps}</div><div style="display:grid;gap:8px;margin-top:10px">${issues}</div>${c.inspectionLevel<2?'<div class="risk-note">Базовая диагностика намеренно не гарантирует раскрытие всех дефектов.</div>':''}<div style="text-align:right;margin-top:14px"><button class="btn secondary" onclick="document.getElementById('modalBack').classList.remove('open')">Закрыть</button></div>`)}
function negotiate(id){const c=state.dealer.market.find(x=>x.id===id);if(!c)return;if(c.seller.status==='reserved')return toast('Машина забронирована — продавец не торгуется','bad');if(c.seller.status==='rep'&&state.rep<c.seller.repMin)return toast(`Для переговоров нужен REP ${c.seller.repMin}`,'bad');if(c.negotiationLockedDay===state.dealer.day)return toast('Сегодня продавец больше не торгуется','bad');const opts=[.85,.90,.95,1].map(r=>Math.round(c.asking*r/1000)*1000);modal(`<h3>Торг: ${c.brand} ${c.model}</h3><p class="muted">Слишком низкая цена может обидеть продавца или привести к продаже конкуренту.</p><div style="display:grid;gap:8px;margin-top:14px">${opts.map((p,i)=>`<button class="btn ${i===3?'secondary':'primary'}" onclick="window.makeOffer('${c.id}',${p})">Предложить ${money(p)}</button>`).join('')}</div>`)}
window.makeOffer=(id,offer)=>{const c=state.dealer.market.find(x=>x.id===id);if(!c)return;const ratio=offer/c.asking,trust=c.seller.trust,acceptChance=clamp((ratio-.82)*3.2+trust*.35,0.05,.97);$('#modalBack').classList.remove('open');if(Math.random()<acceptChance){c.agreedPrice=offer;toast(`Цена согласована: ${money(offer)}`,'good')}else{state.dealer.declines++;if(ratio<.90&&Math.random()<.45){state.dealer.market=state.dealer.market.filter(x=>x.id!==id);state.dealer.market.push(makeCar());toast('Продавец продал машину другому','bad')}else{c.negotiationLockedDay=state.dealer.day;toast('Продавец отказался от предложения','bad')}}save();renderMarket()};
function buyCar(id){const i=state.dealer.market.findIndex(x=>x.id===id);if(i<0)return;const c=state.dealer.market[i],reason=lockReason(c);if(reason)return toast(reason,'bad');const price=c.agreedPrice||c.asking;if(Math.random()>c.seller.buyChance){state.dealer.declines++;c.negotiationLockedDay=state.dealer.day;if(Math.random()<.25){state.dealer.market.splice(i,1);state.dealer.market.push(makeCar());toast('Пока ты оформлял сделку, автомобиль забрал другой покупатель','bad')}else toast('Продавец неожиданно отказался от сделки','bad');save();renderMarket();return}const fee=purchaseFees(price);state.money-=price+fee;state.dealer.expenses+=price+fee;c.purchasePrice=price;c.costBasis=price+fee;c.daysHeld=0;c.offers=[];c.offerDay=0;state.dealer.totalBought++;state.dealer.garage.push(c);state.dealer.market.splice(i,1);state.dealer.market.push(makeCar());state.rep+=1;awardXP(25,'покупка автомобиля');save();renderMarket();toast(`${c.brand} ${c.model} куплен за ${money(price)}`,'good')}
function renderMarket(){ensureDealer();renderTrends();const root=$('#marketGrid');root.innerHTML='';state.dealer.market.forEach((c,i)=>{normalizeCar(c);const reason=lockReason(c),risk=riskOf(c),known=knownIssues(c),status=c.seller.status==='reserved'?['Забронировано','bad']:c.seller.status==='rep'&&state.rep<c.seller.repMin?[`REP ${c.seller.repMin}`,'warn']:['В продаже','ok'],price=c.agreedPrice||c.asking;const signal=c.inspectionLevel>=2?Math.round(((price/trueValue(c))-1)*100):null;const signalText=signal===null?'':`<div class="risk-note">Цена относительно полной оценки: <b style="color:${signal<=-5?'var(--good)':signal>=8?'var(--bad)':'var(--warn)'}">${signal>0?'+':''}${signal}%</b>. Это не гарантия итоговой прибыли.</div>`;const d=document.createElement('article');d.className='car-card'+(reason?' locked':'');d.innerHTML=`<div class="car-visual"><div class="floor"></div>${carSVG(c,'m'+i)}</div><div class="body"><div class="seller-row"><span class="seller-badge">${c.seller.type}</span><span class="status-badge ${status[1]}">${status[0]}</span></div><h4>${c.brand} ${c.model}</h4><div class="subline">${c.year} · ${c.type} · ${Math.round(c.mileage/1000)} тыс. км</div><div style="margin-top:7px"><span class="vin-badge ${c.vinChecked?'ok':''}">${c.vinChecked?'✓ VIN проверен':'VIN не проверен'}</span></div><div class="price">${money(price)}</div><div class="seller-row"><span class="risk-badge ${risk[1]}">Риск: ${c.inspectionLevel?risk[0]:'неизвестен'}</span>${c.agreedPrice?'<span class="status-badge ok">Цена согласована</span>':''}</div><div class="condition"><span class="muted">Состояние</span><div class="bar"><i style="width:${c.inspectionLevel?componentAvg(c):50}%"></i></div><b>${c.inspectionLevel?Math.round(componentAvg(c))+'%':'??'}</b></div><div class="facts"><div class="fact">ДТП<strong>${c.inspectionLevel?c.accidents:'?'}</strong></div><div class="fact">Найдено дефектов<strong>${c.inspectionLevel?known.length:'?'}</strong></div></div>${reason?`<div class="risk-note">${reason}</div>`:signalText||'<div class="risk-note">Даже хорошая диагностика не гарантирует прибыль: рынок и покупатель могут сыграть против тебя.</div>'}<div class="card-actions"><button class="btn small secondary" data-vin="${c.id}" ${c.vinChecked?'disabled':''}>VIN · 9 000 ₽</button><button class="btn small secondary" data-inspect="${c.id}">${c.inspectionLevel?'Отчёт':'Диагностика · 6 000 ₽'}</button>${c.inspectionLevel===1?`<button class="btn small secondary" data-deep="${c.id}">Полная · 22 000 ₽</button>`:''}<button class="btn small warn" data-negotiate="${c.id}">Торг</button><button class="btn small primary" data-buy="${c.id}" ${reason?'disabled':''}>Купить + ${money(purchaseFees(price))}</button></div></div>`;root.appendChild(d)});$$('[data-vin]').forEach(b=>b.onclick=()=>vinCheck(b.dataset.vin));$$('[data-inspect]').forEach(b=>b.onclick=()=>inspectCar(b.dataset.inspect,false));$$('[data-deep]').forEach(b=>b.onclick=()=>inspectCar(b.dataset.deep,true));$$('[data-negotiate]').forEach(b=>b.onclick=()=>negotiate(b.dataset.negotiate));$$('[data-buy]').forEach(b=>b.onclick=()=>buyCar(b.dataset.buy));$('#refreshMarket').textContent=`Следующий день · ${money(8000+state.dealer.garage.length*3000)}`;updateHUD()}
function nextDealerDay(){const daily=8000+state.dealer.garage.length*3000;if(state.money<daily&&state.dealer.garage.length===0)return toast('Недостаточно денег даже на операционные расходы. Продай актив или перезапусти сохранение.','bad');state.money-=daily;state.dealer.expenses+=daily;state.dealer.day++;for(const type of types)state.dealer.trends[type]=clamp((state.dealer.trends[type]||1)+rnd(-4,4)/100,.86,1.16);state.dealer.event=pick(events);for(const c of state.dealer.garage){c.daysHeld++;c.costBasis+=3000;c.offers=[];c.offerDay=0;if(Math.random()<.10){const keys=Object.keys(c.components),k=pick(keys);c.components[k]=clamp(c.components[k]-rnd(3,9),20,100);if(c.components[k]<65&&!c.issues.some(i=>i.component===k)){const d=issueDefs[k];c.issues.push({id:uid(),component:k,name:d[0],estimate:rnd(d[1],d[2]),severity:100-c.components[k]});toast(`Новая неисправность: ${c.brand} — ${d[0]}`,'bad')}}}state.dealer.market=Array.from({length:marketSlots()},makeCar);state.dealer.auctions=[];state.dealer.auctionDay=0;save();renderMarket();toast(`День ${state.dealer.day}. Расходы: ${money(daily)}`,'warn')}
$('#refreshMarket').onclick=nextDealerDay;

/* ---------- Dealer auctions ---------- */
function makeAuction(){const c=makeCar();c.seller.status='available';c.seller.repMin=0;c.agreedPrice=0;c.vinChecked=false;const fair=trueValue(c),start=Math.max(60000,Math.round(fair*rnd(62,78)/100/5000)*5000);return {id:uid(),car:c,current:start,npcLimit:Math.round(fair*rnd(88,112)/100/5000)*5000,userLeading:false,userBid:0}}
function ensureAuctions(){ensureMeta();if(state.dealer.auctionDay!==state.dealer.day||!state.dealer.auctions.length){state.dealer.auctions=Array.from({length:3},makeAuction);state.dealer.auctionDay=state.dealer.day;save()}}
function renderAuctions(){ensureAuctions();const root=$('#auctionGrid');if(!root)return;root.innerHTML=state.dealer.auctions.map((a,i)=>{const c=a.car;return `<article class="auction-card"><div class="car-visual"><div class="floor"></div>${carSVG(c,'a'+i)}</div><div class="body"><div class="seller-row"><span class="seller-badge">Закрытый аукцион</span><span class="status-badge ${a.userLeading?'ok':'warn'}">${a.userLeading?'Ты лидер':'Торги идут'}</span></div><h4>${c.brand} ${c.model}</h4><div class="subline">${c.year} · ${c.type} · заявлено ${Math.round(c.mileage/1000)} тыс. км</div><div class="auction-price">${money(a.current)}</div><div class="auction-state">Осмотр ограничен. Скрытые дефекты и история полностью раскроются только после покупки.</div><div class="card-actions"><button class="btn small secondary" data-abid="${a.id}" data-inc="5000">+5k</button><button class="btn small secondary" data-abid="${a.id}" data-inc="20000">+20k</button><button class="btn small secondary" data-abid="${a.id}" data-inc="50000">+50k</button><button class="btn small ${a.userLeading?'good':'primary'}" data-awin="${a.id}" ${!a.userLeading?'disabled':''}>Забрать</button></div></div></article>`}).join('');$$('[data-abid]').forEach(b=>b.onclick=()=>auctionBid(b.dataset.abid,Number(b.dataset.inc)));$$('[data-awin]').forEach(b=>b.onclick=()=>finishAuction(b.dataset.awin))}
function auctionBid(id,inc){const a=state.dealer.auctions.find(x=>x.id===id);if(!a)return;const bid=a.current+inc;if(state.money<bid+purchaseFees(bid))return toast('Не хватает средств для такой ставки','bad');a.current=bid;a.userBid=bid;if(bid<=a.npcLimit&&Math.random()<.84){a.current=Math.min(a.npcLimit,bid+pick([5000,10000,15000,20000]));a.userLeading=false;toast(`Конкурент перебил: ${money(a.current)}`,'warn')}else{a.userLeading=true;toast('Ты лидер торгов','good')}save();renderAuctions()}
function finishAuction(id){const idx=state.dealer.auctions.findIndex(x=>x.id===id);if(idx<0)return;const a=state.dealer.auctions[idx];if(!a.userLeading)return toast('Сначала нужно выйти в лидеры','bad');if(state.dealer.garage.length>=state.dealer.capacity)return toast('В гараже нет места','bad');const fee=purchaseFees(a.current),total=a.current+fee;if(state.money<total)return toast(`Нужно ${money(total)}`,'bad');state.money-=total;state.dealer.expenses+=total;const c=normalizeCar(a.car);c.purchasePrice=a.current;c.costBasis=total;c.daysHeld=0;c.offers=[];c.offerDay=0;state.dealer.garage.push(c);state.dealer.totalBought++;state.career.auctionWins++;trackEvent('auction',1);awardXP(130,'победа на аукционе');state.rep+=2;state.dealer.auctions.splice(idx,1);state.dealer.auctions.push(makeAuction());save();renderAuctions();renderMarket();toast(`${c.brand} ${c.model} выигран за ${money(a.current)}`,'good')}

