function selectGarage(id,scroll=true){selectedGarage=id;const c=state.dealer.garage.find(x=>x.id===id);if(!c)return;const known=knownIssues(c),range=c.inspectionLevel>=2?[trueValue(c)*.92,trueValue(c)*1.07]:[trueValue(c)*.78,trueValue(c)*1.19],offersValid=c.offerDay===state.dealer.day&&c.offers.length;$('#garageActions').innerHTML=`<h3>${c.brand} ${c.model}</h3><p class="muted">Оценка рынка: ${money(range[0])} — ${money(range[1])}</p><div class="stat-grid"><div class="stat"><span class="muted">Вложено</span><strong>${money(c.costBasis)}</strong></div><div class="stat"><span class="muted">Дней</span><strong>${c.daysHeld}</strong></div></div><div class="risk-note">Каждый следующий день добавляет 3 000 ₽ хранения. Известных дефектов: ${known.length}. ${c.inspectionLevel<2?'Скрытые ещё возможны.':'Полная диагностика выполнена.'}</div><div class="service-grid"><button class="service" data-service="vin">🧾 VIN-проверка<small>${c.vinChecked?'уже проверен':'9 000 ₽ · пробег, ДТП, история'}</small></button><button class="service" data-service="scan">🩺 Полная диагностика<small>${c.inspectionLevel>=2?'уже сделана':'22 000 ₽ · раскрыть все дефекты'}</small></button><button class="service" data-service="repair">🔧 Ремонт дефекта<small>цена может выйти выше сметы</small></button><button class="service" data-service="repairall">🧰 Ремонт всех известных<small>быстрее, но возможен перерасход</small></button><button class="service" data-service="wash">🫧 Мойка<small>2 500 ₽ · косметика</small></button><button class="service" data-service="detail">✨ Детейлинг<small>17 000 ₽ · кузов + салон</small></button><button class="service" data-service="tune">🛞 Тюнинг<small>35 000 ₽ · может не окупиться</small></button></div>${offersValid?renderOffers(c):`<button class="btn primary" style="width:100%;margin-top:12px" data-offers>Получить 3 предложения · 3 000 ₽</button>`}`;$$('[data-service]').forEach(b=>b.onclick=()=>serviceCar(c,b.dataset.service));if($('[data-offers]'))$('[data-offers]').onclick=()=>requestOffers(c);$$('[data-sell]').forEach(b=>b.onclick=()=>sellCar(c,Number(b.dataset.sell)));renderGarageSelectionOnly();if(scroll&&innerWidth<1040)$('#garageActions').scrollIntoView({behavior:'smooth',block:'start'})}
function renderGarageSelectionOnly(){$$('.garage-car').forEach(el=>el.classList.remove('selected'));const btn=$(`[data-select="${selectedGarage}"]`);if(btn)btn.closest('.garage-car').classList.add('selected')}
function serviceCostMultiplier(){return state.dealer.event?.parts||1}
function serviceCar(c,type){
  if(type==='vin'){if(c.vinChecked)return toast('VIN уже проверен');const cost=9000;if(state.money<cost)return toast('Не хватает денег','bad');state.money-=cost;state.dealer.expenses+=cost;c.costBasis+=cost;c.vinChecked=true;c.mileage=c.realMileage;c.accidents=c.realAccidents;state.career.vinChecks++;trackEvent('vin',1);awardXP(35,'VIN-проверка');toast((c.fraud.odometer||c.fraud.hiddenAccident||c.history!=='clean')?'VIN выявил важные факты об истории':'VIN: серьёзных расхождений нет',(c.fraud.odometer||c.fraud.hiddenAccident||c.history!=='clean')?'warn':'good')}
  if(type==='scan'){if(c.inspectionLevel>=2)return toast('Полная диагностика уже выполнена');const cost=22000;if(state.money<cost)return toast('Не хватает денег','bad');state.money-=cost;state.dealer.expenses+=cost;c.costBasis+=cost;c.inspectionLevel=2;c.revealed=c.issues.map(i=>i.id);toast('Все текущие дефекты раскрыты','good')}
  if(type==='wash'){if(c.wash>=100)return toast('Машина уже чистая');const cost=2500;if(state.money<cost)return toast('Не хватает денег','bad');state.money-=cost;state.dealer.expenses+=cost;c.costBasis+=cost;c.wash=clamp(c.wash+35,0,100)}
  if(type==='detail'){const cost=17000;if(state.money<cost)return toast('Не хватает денег','bad');state.money-=cost;state.dealer.expenses+=cost;c.costBasis+=cost;c.wash=100;c.components.body=clamp(c.components.body+rnd(3,8),0,100);c.components.interior=clamp(c.components.interior+rnd(5,11),0,100)}
  if(type==='tune'){if(c.tune>=3)return toast('Максимальный уровень тюнинга');const cost=35000;if(state.money<cost)return toast('Не хватает денег','bad');state.money-=cost;state.dealer.expenses+=cost;c.costBasis+=cost;c.tune++;if(Math.random()<.20)c.tuneAffinity=Math.max(.18,c.tuneAffinity-.15);toast(c.tuneAffinity>.65?'Тюнинг подходит этой машине':'Не факт, что рынок оценит этот тюнинг',c.tuneAffinity>.65?'good':'warn')}
  if(type==='repair'||type==='repairall'){const known=knownIssues(c);if(!known.length)return toast(c.inspectionLevel<2?'Сначала найди дефекты':'Известных дефектов нет');const targets=type==='repairall'?known:[known.sort((a,b)=>b.severity-a.severity)[0]];const base=targets.reduce((s,i)=>s+i.estimate,0),actual=Math.round(base*serviceCostMultiplier()*rnd(86,138)/100/1000)*1000;if(state.money<actual)return toast(`Сервис выставил ${money(actual)} — денег не хватает`,'bad');state.money-=actual;state.dealer.expenses+=actual;c.costBasis+=actual;for(const i of targets){c.issues=c.issues.filter(x=>x.id!==i.id);c.revealed=c.revealed.filter(x=>x!==i.id);c.components[i.component]=clamp(c.components[i.component]+rnd(14,30),0,100)}if(Math.random()<.07){const k=pick(Object.keys(c.components));c.components[k]=clamp(c.components[k]-rnd(4,10),0,100);toast('После ремонта проявилась другая проблема','bad')}else toast(`Ремонт: ${money(actual)}`,actual>base?'warn':'good')}
  c.offers=[];c.offerDay=0;save();renderGarage();selectGarage(c.id,false)
}
function requestOffers(c){const cost=3000,emergency=state.money<cost;if(!emergency){state.money-=cost;state.dealer.expenses+=cost;c.costBasis+=cost}const value=trueValue(c),repBoost=Math.min(.05,state.rep*.001)+(state.dealer.showroom-1)*.02,condition=componentAvg(c)/100;const quick=Math.max(60000,Math.round(value*rnd(78,91)/100/1000)*1000),privateOffer=Math.max(60000,Math.round(value*(rnd(88,106)/100+repBoost)/1000)*1000),enthusiastBase=c.tune>0?(rnd(92,111)/100+c.tuneAffinity*.04):(rnd(84,103)/100);const enthusiast=Math.max(60000,Math.round(value*enthusiastBase*(.94+condition*.06)/1000)*1000);c.offers=emergency?[{name:'Экстренный выкуп',price:Math.max(50000,Math.round(value*rnd(70,82)/100/1000)*1000),fee:.01}]:[{name:buyerNames[0],price:quick,fee:.015},{name:buyerNames[1],price:privateOffer,fee:.025},{name:buyerNames[2],price:enthusiast,fee:.03}];c.offerDay=state.dealer.day;save();selectGarage(c.id,false);const best=Math.max(...c.offers.map(o=>o.price*(1-o.fee)));toast(emergency?'Доступен только экстренный выкуп':best>c.costBasis?'Есть предложение выше вложений':'Все предложения пока ниже вложений',emergency?'warn':best>c.costBasis?'good':'bad')}
function renderOffers(c){return `<div class="offer-grid">${c.offers.map((o,i)=>{const net=o.price*(1-o.fee),profit=net-c.costBasis;return `<div class="offer"><small>${o.name} · комиссия ${Math.round(o.fee*1000)/10}%</small><strong>${money(o.price)}</strong><small>${profit>=0?'Ожидаемая прибыль':'Ожидаемый убыток'}: ${money(Math.abs(profit))}</small><button class="btn small ${profit>=0?'good':'danger'}" style="margin-top:8px" data-sell="${i}">${profit>=0?'Продать':'Продать в минус'}</button></div>`}).join('')}</div><button class="btn secondary" style="width:100%" data-offers>Обновить предложения · 3 000 ₽</button>`}
function sellCar(c,index){const o=c.offers[index];if(!o||c.offerDay!==state.dealer.day)return toast('Предложение устарело','bad');const fee=Math.round(o.price*o.fee/1000)*1000,net=o.price-fee,profit=net-c.costBasis;state.money+=net;state.dealer.revenue+=net;state.dealer.deals++;state.dealer.profit+=profit;state.dealer.bestDeal=Math.max(state.dealer.bestDeal,profit);if(profit<0)state.dealer.losses++;trackEvent('deal',1);if(profit>0)trackEvent('profit',profit);awardXP(Math.max(30,Math.min(170,55+Math.max(0,profit)/2500)),'сделка');state.rep=Math.max(0,state.rep+(profit>0?Math.max(1,Math.floor(profit/70000)+1):profit<-70000?-1:0));state.dealer.garage=state.dealer.garage.filter(x=>x.id!==c.id);selectedGarage=null;save();renderGarage();toast(`${c.brand} продан. ${profit>=0?'Прибыль':'Убыток'} ${money(Math.abs(profit))}`,profit>=0?'good':'bad')}
function upgradeGarage(){const cost=state.dealer.capacity===3?180000:state.dealer.capacity===4?300000:null;if(!cost)return toast('Гараж уже максимального размера');if(state.money<cost)return toast(`Нужно ${money(cost)}`,'bad');state.money-=cost;state.dealer.expenses+=cost;state.dealer.capacity++;save();updateHUD();toast(`Гараж расширен до ${state.dealer.capacity} мест`,'good')}
$('#upgradeGarage').onclick=upgradeGarage;
$$('[data-dtab]').forEach(b=>b.onclick=()=>{const tab=b.dataset.dtab;$$('[data-dtab]').forEach(x=>x.classList.toggle('active',x===b));$('#dealerMarket').style.display=tab==='market'?'block':'none';$('#dealerAuction').style.display=tab==='auction'?'block':'none';$('#dealerGarage').style.display=tab==='garage'?'block':'none';$('#dealerStats').style.display=tab==='stats'?'block':'none';if(tab==='auction'){ensureAuctions();renderAuctions()}if(tab==='garage')renderGarage();updateHUD()});

/* self checks */
function selfCheck(){const errors=[];for(let i=0;i<parkingLevels.length;i++){const L=parkingLevels[i],c={x:L.slot.x,y:L.slot.y,a:L.slot.a,v:0,w:50,h:96,hitW:43,hitH:88};const q=parkingQuality(c,L.slot);if(!q.inside||q.angle<.99)errors.push('parking target '+(i+1));const s={x:L.start[0],y:L.start[1],a:L.start[2],w:50,h:96,hitW:43,hitH:88};const old=parking.traffic;parking.traffic=(L.traffic||[]).map(t=>({...t,hitW:44,hitH:88}));if(collision(s,L))errors.push('parking start '+(i+1));parking.traffic=old}let under=0,over=0,locked=0;for(let i=0;i<300;i++){const c=makeCar(),v=trueValue(c);if(!Number.isFinite(v)||v<=0)errors.push('dealer value');if(Object.keys(c.components).length!==7)errors.push('components');if(c.asking<v*.92)under++;if(c.asking>v*1.08)over++;if(c.seller.status!=='available')locked++}if(!under||!over||!locked)errors.push('dealer distribution');window.__SELF_CHECK__={ok:!errors.length,errors,dealer:{under,over,locked}};document.body.dataset.appReady=errors.length?'error':'true'}
ensureMeta();normalizeDealer();ensureDealer();ensureAuctions();updateHUD();renderLevelButtons();renderMarket();renderAuctions();checkAchievements();selfCheck();
})();
